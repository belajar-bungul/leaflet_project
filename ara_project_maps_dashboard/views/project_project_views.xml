<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- View project.project form -->
    <record id="view_project_project_form" model="ir.ui.view">
        <field name="name">view.project.project.form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='description']" position="after">
                <page name="location" string="Location">
                    <group>
                        <field name="ara_project_location"/>
                        <field name="ara_project_latitude"/>
                        <field name="ara_project_longitude"/>
                    </group>
                    
                </page>
            </xpath>
        </field>
    </record>

</odoo>